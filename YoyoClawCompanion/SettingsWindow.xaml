<Window x:Class="YoyoClawCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Dynamic Island" Width="920" Height="720" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" Foreground="#182033">
    <Window.Resources>
        <Geometry x:Key="IconSpark">M12,1 L14.5,8.5 L22,11 L14.5,13.5 L12,21 L9.5,13.5 L2,11 L9.5,8.5 Z</Geometry>
        <Geometry x:Key="IconPin">M8,2 L16,2 L15,8 L19,12 L13,12 L13,21 L11,21 L11,12 L5,12 L9,8 Z</Geometry>
        <Geometry x:Key="IconCircle">M12,2 A10,10 0 1 1 11.9,2 M12,7 A5,5 0 1 0 12.1,7</Geometry>
        <Geometry x:Key="IconChart">M3,19 L3,4 M3,19 L21,19 M6,15 L10,11 L14,13 L20,6</Geometry>
        <Geometry x:Key="IconCoin">M12,2 A10,10 0 1 1 11.9,2 M12,6 L12,18 M8,9 C8,6 16,6 16,9 C16,12 8,11 8,15 C8,18 16,18 16,15</Geometry>
        <Geometry x:Key="IconClock">M12,2 A10,10 0 1 1 11.9,2 M12,6 L12,12 L17,15</Geometry>
        <Geometry x:Key="IconLaunch">M5,19 L19,5 M11,5 L19,5 L19,13</Geometry>
        <Geometry x:Key="IconEye">M2,12 C6,5 18,5 22,12 C18,19 6,19 2,12 M12,8 A4,4 0 1 1 11.9,8</Geometry>
        <Geometry x:Key="IconScreen">M3,5 L9,5 M3,5 L3,11 M21,5 L15,5 M21,5 L21,11 M3,19 L9,19 M3,19 L3,13 M21,19 L15,19 M21,19 L21,13</Geometry>
        <Geometry x:Key="IconCheck">M3,12 L9,18 L21,5</Geometry>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="SwitchCard" Height="62" Padding="10" CornerRadius="16" Background="#083ED598" BorderBrush="#303ED598" BorderThickness="1.5">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="12" Background="#737C90">
                            <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="White" Fill="Transparent" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="21" Height="21" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                        <Border x:Name="ToggleTrack" Grid.Column="2" Width="44" Height="24" CornerRadius="12" Background="#AAB2C0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse x:Name="ToggleKnob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="SwitchCard" Property="Background" Value="#123ED598"/><Setter TargetName="SwitchCard" Property="BorderBrush" Value="#623ED598"/>
                        <Setter TargetName="IconTile" Property="Background" Value="#43A878"/><Setter TargetName="ToggleTrack" Property="Background" Value="#43A878"/>
                        <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchCard" Property="BorderBrush" Value="#9A43A878"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchCard" Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,5,0,10"/></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="30"/></Style>
        <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,8,8,0"/></Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#143ED598"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#243ED598"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Background" Value="White"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="NavPane" Background="#E9EDF4" Padding="18,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,26">
                    <Border Width="42" Height="42" CornerRadius="14" Background="#182033">
                        <Grid>
                            <Ellipse Width="7" Height="7" Fill="#3ED598" HorizontalAlignment="Left" Margin="9,0,0,0"/>
                            <Ellipse Width="7" Height="7" Fill="#8FA0FF"/>
                            <Ellipse Width="7" Height="7" Fill="#F2C94C" HorizontalAlignment="Right" Margin="0,0,9,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,1,0,0"><TextBlock x:Name="NavTitle" Text="AI Dynamic" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="NavSubtitle" Text="Island" Foreground="#657087" FontSize="13"/></StackPanel>
                </StackPanel>
                <Button Style="{StaticResource NavButton}" Tag="AppearanceCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Rectangle Width="13" Height="13" RadiusX="4" RadiusY="4" Fill="#8FA0FF" Margin="0,0,12,0"/><TextBlock Text="外观"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="ComponentCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="13" Height="13" Fill="#3ED598" Margin="0,0,12,0"/><TextBlock Text="组件"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="FeatureCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Polygon Points="6.5,0 13,13 0,13" Fill="#F2C94C" Width="13" Height="13" Margin="0,0,12,0"/><TextBlock Text="行为"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="NotificationCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="13" Height="13" CornerRadius="7" BorderBrush="#F2686F" BorderThickness="3" Margin="0,0,12,0"/><TextBlock Text="提醒"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="PositionCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Path Data="M 1,6 L 12,6 M 6,1 L 6,12" Stroke="#657087" StrokeThickness="2" Width="13" Height="13" Stretch="Fill" Margin="0,0,12,0"/><TextBlock Text="位置"/></StackPanel></Button>
            </StackPanel>
        </Border>

        <Border x:Name="RightPane" Grid.Column="1" Background="#F3F5F9">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="30,26,34,36">
                    <TextBlock x:Name="TitleText" Text="设置" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SubtitleText" Text="AI Dynamic Island" Foreground="#657087" FontSize="13" Margin="0,3,0,22"/>

                    <Border x:Name="AppearanceCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold"/>
                        <Border x:Name="PreviewSurface" Height="94" CornerRadius="15" Background="#EEF1F7" Margin="0,14,0,18">
                            <Border x:Name="PreviewIsland" Width="280" Height="52" CornerRadius="24" Background="#F4FFFFFF" BorderBrush="#24182033" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="全部就绪" Foreground="#3ED598" FontWeight="SemiBold" VerticalAlignment="Center"/><Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2" Fill="#8FA0FF" Opacity=".55" Margin="14,0" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#3ED598"/><Ellipse Width="7" Height="7" Fill="#3ED598" Margin="8,0"/><Ellipse Width="7" Height="7" Fill="#3ED598"/></StackPanel></Grid>
                            </Border>
                        </Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="颜色模式" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="system" Content="跟随系统"/><ComboBoxItem Tag="light" Content="浅色"/><ComboBoxItem Tag="dark" Content="深色"/></ComboBox></Grid>
                        <DockPanel Margin="0,14,0,0"><TextBlock Text="圆角"/><TextBlock x:Name="CornerValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="CornerSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="不透明度"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="宽度"/><TextBlock x:Name="WidthValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="WidthSlider" Minimum="190" Maximum="340" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="高度"/><TextBlock x:Name="HeightValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="HeightSlider" Minimum="32" Maximum="72" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="文本大小"/><TextBlock x:Name="TextSizeValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="TextSizeSlider" Minimum="9" Maximum="16" TickFrequency="0.5" ValueChanged="Setting_ValueChanged"/>
                        <UniformGrid Columns="2"><CheckBox x:Name="ShadowCheck" Tag="{StaticResource IconSpark}" Content="阴影" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="TopmostCheck" Tag="{StaticResource IconPin}" Content="始终置顶" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                    </StackPanel></Border>

                    <Border x:Name="ComponentCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="组件" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><UniformGrid Columns="2"><CheckBox x:Name="QuotaCheck" Tag="{StaticResource IconCircle}" Content="YOYO 积分环" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="YoyoCheck" Tag="{StaticResource IconCircle}" Content="YOYO 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="CodexCheck" Tag="{StaticResource IconChart}" Content="Codex 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="WorkBuddyCheck" Tag="{StaticResource IconCoin}" Content="WorkBuddy 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="TrayIconCheck" Tag="{StaticResource IconScreen}" Content="系统托盘图标" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid></StackPanel></Border>

                    <Border x:Name="FeatureCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="行为" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="显示模式" VerticalAlignment="Center"/><ComboBox x:Name="DisplayModeCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="always" Content="始终显示"/><ComboBoxItem Tag="activeOnly" Content="仅任务活动时显示"/></ComboBox></Grid>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><TextBlock Text="程序顺序" VerticalAlignment="Center"/><ComboBox x:Name="ProviderOrderCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="yoyo,codex,workbuddy" Content="YOYO → Codex → WorkBuddy"/><ComboBoxItem Tag="yoyo,workbuddy,codex" Content="YOYO → WorkBuddy → Codex"/><ComboBoxItem Tag="codex,yoyo,workbuddy" Content="Codex → YOYO → WorkBuddy"/><ComboBoxItem Tag="codex,workbuddy,yoyo" Content="Codex → WorkBuddy → YOYO"/><ComboBoxItem Tag="workbuddy,yoyo,codex" Content="WorkBuddy → YOYO → Codex"/><ComboBoxItem Tag="workbuddy,codex,yoyo" Content="WorkBuddy → Codex → YOYO"/></ComboBox></Grid>
                        <UniformGrid Columns="2"><CheckBox x:Name="CodexActivityCheck" Tag="{StaticResource IconClock}" Content="Codex 活动检测" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="CodexLimitsCheck" Tag="{StaticResource IconChart}" Content="Codex 限额" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="WorkBuddyCreditsCheck" Tag="{StaticResource IconCoin}" Content="WorkBuddy 积分" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="AppLaunchCheck" Tag="{StaticResource IconLaunch}" Content="点击打开应用" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="HoverExpansionCheck" Tag="{StaticResource IconEye}" Content="悬停展开" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="SpringAnimationCheck" Tag="{StaticResource IconSpark}" Content="回弹动效" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                        <DockPanel Margin="0,10,0,0"><TextBlock Text="悬停延时"/><TextBlock x:Name="HoverDelayValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="HoverDelaySlider" Minimum="20" Maximum="400" TickFrequency="10" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="滚动速度"/><TextBlock x:Name="QuotaScrollSpeedValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="QuotaScrollSpeedSlider" Minimum="8" Maximum="80" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                    </StackPanel></Border>

                    <Border x:Name="NotificationCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="提醒与自动隐藏" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2"><CheckBox x:Name="CompletionNotificationsCheck" Tag="{StaticResource IconCheck}" Content="任务完成提醒" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="ConfirmationNotificationsCheck" Tag="{StaticResource IconClock}" Content="WorkBuddy 待确认" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="ReverseHoverCheck" Tag="{StaticResource IconEye}" Content="反向选择" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="FullscreenActiveOnlyCheck" Tag="{StaticResource IconScreen}" Content="全屏时活动显示" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="UnchangedAutoHideCheck" Tag="{StaticResource IconClock}" Content="状态未变化时隐藏" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                        <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="回复行数" VerticalAlignment="Center"/><ComboBox x:Name="MaxResponseLinesCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="1" Content="1 行"/><ComboBoxItem Tag="2" Content="2 行"/><ComboBoxItem Tag="3" Content="3 行"/><ComboBoxItem Tag="4" Content="4 行"/><ComboBoxItem Tag="5" Content="5 行"/><ComboBoxItem Tag="6" Content="6 行"/></ComboBox></Grid>
                        <DockPanel><TextBlock Text="完成提醒时长"/><TextBlock x:Name="CompletionDisplayValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="CompletionDisplaySlider" Minimum="3" Maximum="30" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="未变化隐藏"/><TextBlock x:Name="UnchangedAutoHideValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="UnchangedAutoHideSlider" Minimum="1" Maximum="60" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                    </StackPanel></Border>

                    <Border x:Name="PositionCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="位置" FontSize="18" FontWeight="SemiBold"/>
                        <Grid Height="66" Margin="0,12,0,2"><Rectangle Height="42" RadiusX="10" RadiusY="10" Fill="#E9EDF4" VerticalAlignment="Bottom"/><Rectangle Width="180" Height="28" RadiusX="14" RadiusY="14" Fill="#182033" VerticalAlignment="Bottom" Margin="0,0,0,16"/><Path Data="M 0,10 L 10,0 L 20,10" Stroke="#3ED598" StrokeThickness="3" Width="20" Height="10" VerticalAlignment="Top" Stretch="Fill"/></Grid>
                        <WrapPanel><Button Style="{StaticResource ActionButton}" Content="顶部居中" Click="ResetPosition_Click"/><Button Style="{StaticResource ActionButton}" Content="恢复默认" Click="ResetAppearance_Click"/></WrapPanel>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
