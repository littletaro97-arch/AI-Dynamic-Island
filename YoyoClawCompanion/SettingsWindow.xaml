<Window x:Class="YoyoClawCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 灵动岛主页" Width="520" Height="610" MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#182033">
    <Window.Resources>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,6,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,8,8,0"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock Text="AI 灵动岛" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="外观、组件与窗口行为" Foreground="#657087" FontSize="13" Margin="0,4,0,24"/>

            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DockPanel><TextBlock Text="圆角"/><TextBlock x:Name="CornerValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="CornerSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="不透明度"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="宽度"/><TextBlock x:Name="WidthValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="WidthSlider" Minimum="190" Maximum="340" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                    <CheckBox x:Name="ShadowCheck" Content="显示阴影" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="TopmostCheck" Content="始终置顶" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="组件" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="QuotaCheck" Content="显示 YOYO 积分环" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="YoyoCheck" Content="显示 YOYO 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="CodexCheck" Content="显示 Codex 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="WorkBuddyCheck" Content="显示 WorkBuddy 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="位置" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="在灵动岛上按住约 0.4 秒，光标变化后即可拖动。位置会自动保存。" TextWrapping="Wrap" Foreground="#657087" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="恢复到顶部居中" Click="ResetPosition_Click"/>
                        <Button Content="恢复默认外观" Click="ResetAppearance_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
