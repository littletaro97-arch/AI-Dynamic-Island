<Window x:Class="YoyoClawCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="920" Height="720" MinWidth="780" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F3F5F9" Foreground="#182033">
    <Window.Resources>
        <Geometry x:Key="IconSpark">M12,1 L14.5,8.5 L22,11 L14.5,13.5 L12,21 L9.5,13.5 L2,11 L9.5,8.5 Z</Geometry>
        <Geometry x:Key="IconPin">M8,2 L16,2 L15,8 L19,12 L13,12 L13,21 L11,21 L11,12 L5,12 L9,8 Z</Geometry>
        <Geometry x:Key="IconCircle">M12,2 A10,10 0 1 1 11.9,2 M12,7 A5,5 0 1 0 12.1,7</Geometry>
        <Geometry x:Key="IconChart">M3,19 L3,4 M3,19 L21,19 M6,15 L10,11 L14,13 L20,6</Geometry>
        <Geometry x:Key="IconCoin">M12,2 A10,10 0 1 1 11.9,2 M12,6 L12,18 M8,9 C8,6 16,6 16,9 C16,12 8,11 8,15 C8,18 16,18 16,15</Geometry>
        <Geometry x:Key="IconClock">M12,2 A10,10 0 1 1 11.9,2 M12,6 L12,12 L17,15</Geometry>
        <Geometry x:Key="IconLaunch">M5,19 L19,5 M11,5 L19,5 L19,13</Geometry>
        <Geometry x:Key="IconEye">M2,12 C6,5 18,5 22,12 C18,19 6,19 2,12 M12,8 A4,4 0 1 1 11.9,8</Geometry>
        <Geometry x:Key="IconScreen">M3,5 L9,5 M3,5 L3,11 M21,5 L15,5 M21,5 L21,11 M3,19 L9,19 M3,19 L3,13 M21,19 L15,19 M21,19 L21,13</Geometry>
        <Geometry x:Key="IconCheck">M3,12 L9,18 L21,5</Geometry>
        <Geometry x:Key="IconAppearance">M4,6 L20,6 M8,3 L8,9 M4,12 L20,12 M16,9 L16,15 M4,18 L20,18 M10,15 L10,21</Geometry>
        <Geometry x:Key="IconComponents">M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L21,14 L21,21 L14,21 Z</Geometry>
        <Geometry x:Key="IconBehavior">M13,2 L5,13 L11,13 L10,22 L19,10 L13,10 Z</Geometry>
        <Geometry x:Key="IconBell">M6,17 L18,17 L16,14 L16,9 C16,4 8,4 8,9 L8,14 Z M10,20 C11,22 13,22 14,20</Geometry>
        <Geometry x:Key="IconPosition">M12,2 L9,5 M12,2 L15,5 M12,22 L9,19 M12,22 L15,19 M2,12 L5,9 M2,12 L5,15 M22,12 L19,9 M22,12 L19,15 M12,6 L12,18 M6,12 L18,12</Geometry>
        <Geometry x:Key="IconArrowUp">M4,15 L12,7 L20,15</Geometry>
        <Geometry x:Key="IconArrowDown">M4,9 L12,17 L20,9</Geometry>
        <SolidColorBrush x:Key="SettingsInputBackground" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="SettingsInputBorder" Color="#E2E5EA"/>
        <SolidColorBrush x:Key="SettingsPopupBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SettingsTrackBackground" Color="#E9EBEF"/>
        <SolidColorBrush x:Key="SettingsAccent" Color="#10A56F"/>
        <SolidColorBrush x:Key="SettingsHoverBackground" Color="#EEF1F3"/>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="SwitchCard" Height="62" Padding="10" CornerRadius="16" BorderThickness="1.5">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CheckStates">
                            <VisualStateGroup.Transitions>
                                <VisualTransition GeneratedDuration="0:0:0.18">
                                    <VisualTransition.GeneratedEasingFunction><CubicEase EasingMode="EaseOut"/></VisualTransition.GeneratedEasingFunction>
                                </VisualTransition>
                            </VisualStateGroup.Transitions>
                            <VisualState x:Name="Unchecked">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ToggleKnob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="SwitchCard" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#083ED598" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="SwitchCard" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#303ED598" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="IconTile" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#737C90" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="ToggleTrack" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#AAB2C0" Duration="0"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Checked">
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ToggleKnob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="SwitchCard" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#123ED598" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="SwitchCard" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#623ED598" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="IconTile" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#43A878" Duration="0"/>
                                    <ColorAnimation Storyboard.TargetName="ToggleTrack" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#43A878" Duration="0"/>
                                </Storyboard>
                            </VisualState>
                            <VisualState x:Name="Indeterminate"/>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.Background><SolidColorBrush Color="#083ED598"/></Border.Background>
                    <Border.BorderBrush><SolidColorBrush Color="#303ED598"/></Border.BorderBrush>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="12">
                            <Border.Background><SolidColorBrush Color="#737C90"/></Border.Background>
                            <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="24" Height="24" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                        <Border x:Name="ToggleTrack" Grid.Column="2" Width="44" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border.Background><SolidColorBrush Color="#AAB2C0"/></Border.Background>
                            <Ellipse x:Name="ToggleKnob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0">
                                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchCard" Property="Opacity" Value=".96"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchCard" Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,11"/><Setter Property="MinHeight" Value="28"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Height="28" VerticalAlignment="Center">
                    <Border Height="16" CornerRadius="8" Background="{DynamicResource SettingsTrackBackground}" VerticalAlignment="Center"/>
                    <Track x:Name="PART_Track" Margin="2,0" VerticalAlignment="Center" Orientation="{TemplateBinding Orientation}"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                           IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="16" Margin="0,0,-12,0" CornerRadius="8" Background="{DynamicResource SettingsAccent}"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Width="24" Height="24" Focusable="False">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Grid x:Name="ThumbSurface" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                                    <Ellipse Fill="White" Stroke="#16000000" StrokeThickness="1">
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.26"/></Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.07" ScaleY="1.07"/></Setter.Value></Setter></Trigger>
                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbSurface" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.12" ScaleY="1.12"/></Setter.Value></Setter></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="Transparent" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                        </RepeatButton></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="4,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemSurface" Padding="{TemplateBinding Padding}" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource SettingsHoverBackground}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#727C90"/><Setter Property="Foreground" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="12,0,34,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="ComboSurface" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1" CornerRadius="9"/>
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False"/>
                    <Path Data="M2,4 L7,9 L12,4" Stroke="#8B9099" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="10" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                    <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Padding="0,4" CornerRadius="9" Background="{DynamicResource SettingsPopupBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1">
                            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity=".18"/></Border.Effect>
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#7A10A56F"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="ComboSurface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="8,7"/><Setter Property="Margin" Value="2,8,2,0"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="Background" Value="{DynamicResource SettingsInputBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ActionSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionSurface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="ActionSurface" Property="Background" Value="#143ED598"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ActionSurface" Property="Background" Value="#2A3ED598"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionSurface" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProviderOrderButton" TargetType="Button">
            <Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="OrderButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OrderButtonSurface" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="OrderButtonSurface" Property="Background" Value="#143ED598"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="OrderButtonSurface" Property="Background" Value="#2A3ED598"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="OrderButtonSurface" Property="Opacity" Value=".3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProviderOrderItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="True"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PositionPresetButton" TargetType="RadioButton">
            <Setter Property="Width" Value="104"/><Setter Property="Height" Value="38"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="PresetSurface" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1" CornerRadius="11" Padding="12,0">
                    <Grid><Ellipse x:Name="PresetDot" Width="7" Height="7" Fill="#727C90" HorizontalAlignment="Left"/><TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PresetSurface" Property="BorderBrush" Value="#7A3ED598"/></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="PresetSurface" Property="Background" Value="#203ED598"/><Setter TargetName="PresetSurface" Property="BorderBrush" Value="#3ED598"/><Setter TargetName="PresetSurface" Property="BorderThickness" Value="2"/><Setter TargetName="PresetDot" Property="Fill" Value="#3ED598"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NudgeButton" TargetType="Button">
            <Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="{DynamicResource SettingsInputBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NudgeSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NudgeSurface" Property="BorderBrush" Value="#3ED598"/><Setter TargetName="NudgeSurface" Property="Background" Value="#143ED598"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NudgeSurface" Property="Background" Value="#2A3ED598"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavSurface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#143ED598"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#243ED598"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="Background" Value="White"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="NavPane" Background="#E9EDF4" Padding="18,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,0,0,26">
                    <Border Width="42" Height="42" CornerRadius="14" Background="#182033">
                        <Grid>
                            <Ellipse Width="7" Height="7" Fill="#3ED598" HorizontalAlignment="Left" Margin="9,0,0,0"/>
                            <Ellipse Width="7" Height="7" Fill="#8FA0FF"/>
                            <Ellipse Width="7" Height="7" Fill="#F2C94C" HorizontalAlignment="Right" Margin="0,0,9,0"/>
                        </Grid>
                    </Border>
                    <StackPanel Margin="10,1,0,0"><TextBlock x:Name="NavTitle" Text="AI Dynamic" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="NavSubtitle" Text="Island" Foreground="#657087" FontSize="13"/></StackPanel>
                </StackPanel>
                <Button Style="{StaticResource NavButton}" Tag="PresetCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#183ED598" Margin="0,0,11,0"><Path Data="{StaticResource IconCheck}" Stroke="#3ED598" StrokeThickness="2" Width="17" Height="17" Stretch="Uniform"/></Border><TextBlock Text="预设" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="AppearanceCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#188FA0FF" Margin="0,0,11,0"><Path Data="{StaticResource IconAppearance}" Stroke="#8FA0FF" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><TextBlock Text="外观" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="ComponentCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#183ED598" Margin="0,0,11,0"><Path Data="{StaticResource IconComponents}" Fill="#3ED598" Width="17" Height="17" Stretch="Uniform"/></Border><TextBlock Text="组件" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="FeatureCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#18F2C94C" Margin="0,0,11,0"><Path Data="{StaticResource IconBehavior}" Fill="#D9A900" Width="17" Height="19" Stretch="Uniform"/></Border><TextBlock Text="行为" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="NotificationCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#18F2686F" Margin="0,0,11,0"><Path Data="{StaticResource IconBell}" Stroke="#F2686F" Fill="Transparent" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" StrokeLineJoin="Round"/></Border><TextBlock Text="提醒" VerticalAlignment="Center"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Tag="PositionCard" Click="Nav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" CornerRadius="9" Background="#18657087" Margin="0,0,11,0"><Path Data="{StaticResource IconPosition}" Stroke="#657087" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Border><TextBlock Text="位置" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
        </Border>

        <Border x:Name="RightPane" Grid.Column="1" Background="#F3F5F9">
            <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="SettingsScroll_PreviewMouseWheel">
                <StackPanel Margin="30,26,34,36">
                    <TextBlock x:Name="TitleText" Text="设置" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,22"/>
                    <TextBlock x:Name="SubtitleText" Text="" Visibility="Collapsed"/>

                    <Border x:Name="PresetCard" Style="{StaticResource Card}">
                        <Border.Resources><Style TargetType="TextBox"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/></Style></Border.Resources>
                        <StackPanel>
                        <TextBlock Text="预设方案" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="保存当前配置，之后可一键恢复。应用路径和运行状态不会写入方案。" Foreground="#727C90" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap"/>
                        <UniformGrid Columns="3">
                            <Border Margin="0,0,8,0" Padding="12" CornerRadius="14" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1"><StackPanel><Grid Height="22"><Grid x:Name="Preset1NameDisplay" Tag="1" ClipToBounds="True" MouseLeftButtonDown="PresetNameDisplay_MouseLeftButtonDown" ToolTip="单击重命名"><Canvas x:Name="Preset1NameCanvas"><TextBlock x:Name="Preset1NameText" FontWeight="SemiBold" Text="方案 1"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset1NameTranslate"/></TextBlock.RenderTransform></TextBlock><TextBlock x:Name="Preset1NameClone" FontWeight="SemiBold" Visibility="Collapsed"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset1NameCloneTranslate"/></TextBlock.RenderTransform></TextBlock></Canvas></Grid><TextBox x:Name="Preset1NameEditor" Tag="1" Visibility="Collapsed" KeyDown="PresetNameEditor_KeyDown" LostKeyboardFocus="PresetNameEditor_LostKeyboardFocus" MaxLength="60" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Padding="0"/></Grid><TextBlock x:Name="Preset1Status" Text="尚未保存" Foreground="#727C90" FontSize="11" Margin="0,3,0,4"/><UniformGrid Columns="2"><Button Style="{StaticResource ActionButton}" Tag="1" Content="保存当前" Click="SavePreset_Click"/><Button x:Name="ApplyPreset1Button" Style="{StaticResource ActionButton}" Tag="1" Content="应用" Click="ApplyPreset_Click"/></UniformGrid></StackPanel></Border>
                            <Border Margin="4,0" Padding="12" CornerRadius="14" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1"><StackPanel><Grid Height="22"><Grid x:Name="Preset2NameDisplay" Tag="2" ClipToBounds="True" MouseLeftButtonDown="PresetNameDisplay_MouseLeftButtonDown" ToolTip="单击重命名"><Canvas x:Name="Preset2NameCanvas"><TextBlock x:Name="Preset2NameText" FontWeight="SemiBold" Text="方案 2"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset2NameTranslate"/></TextBlock.RenderTransform></TextBlock><TextBlock x:Name="Preset2NameClone" FontWeight="SemiBold" Visibility="Collapsed"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset2NameCloneTranslate"/></TextBlock.RenderTransform></TextBlock></Canvas></Grid><TextBox x:Name="Preset2NameEditor" Tag="2" Visibility="Collapsed" KeyDown="PresetNameEditor_KeyDown" LostKeyboardFocus="PresetNameEditor_LostKeyboardFocus" MaxLength="60" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Padding="0"/></Grid><TextBlock x:Name="Preset2Status" Text="尚未保存" Foreground="#727C90" FontSize="11" Margin="0,3,0,4"/><UniformGrid Columns="2"><Button Style="{StaticResource ActionButton}" Tag="2" Content="保存当前" Click="SavePreset_Click"/><Button x:Name="ApplyPreset2Button" Style="{StaticResource ActionButton}" Tag="2" Content="应用" Click="ApplyPreset_Click"/></UniformGrid></StackPanel></Border>
                            <Border Margin="8,0,0,0" Padding="12" CornerRadius="14" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1"><StackPanel><Grid Height="22"><Grid x:Name="Preset3NameDisplay" Tag="3" ClipToBounds="True" MouseLeftButtonDown="PresetNameDisplay_MouseLeftButtonDown" ToolTip="单击重命名"><Canvas x:Name="Preset3NameCanvas"><TextBlock x:Name="Preset3NameText" FontWeight="SemiBold" Text="方案 3"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset3NameTranslate"/></TextBlock.RenderTransform></TextBlock><TextBlock x:Name="Preset3NameClone" FontWeight="SemiBold" Visibility="Collapsed"><TextBlock.RenderTransform><TranslateTransform x:Name="Preset3NameCloneTranslate"/></TextBlock.RenderTransform></TextBlock></Canvas></Grid><TextBox x:Name="Preset3NameEditor" Tag="3" Visibility="Collapsed" KeyDown="PresetNameEditor_KeyDown" LostKeyboardFocus="PresetNameEditor_LostKeyboardFocus" MaxLength="60" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Padding="0"/></Grid><TextBlock x:Name="Preset3Status" Text="尚未保存" Foreground="#727C90" FontSize="11" Margin="0,3,0,4"/><UniformGrid Columns="2"><Button Style="{StaticResource ActionButton}" Tag="3" Content="保存当前" Click="SavePreset_Click"/><Button x:Name="ApplyPreset3Button" Style="{StaticResource ActionButton}" Tag="3" Content="应用" Click="ApplyPreset_Click"/></UniformGrid></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel></Border>

                    <Border x:Name="AppearanceCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="外观" FontSize="18" FontWeight="SemiBold"/>
                        <Border x:Name="PreviewSurface" Height="94" CornerRadius="15" Background="#EEF1F7" Margin="0,14,0,18">
                            <Border x:Name="PreviewIsland" Width="280" Height="52" CornerRadius="24" Background="#F4FFFFFF" BorderBrush="#24182033" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="全部就绪" Foreground="#3ED598" FontWeight="SemiBold" VerticalAlignment="Center"/><Rectangle Grid.Column="1" Height="4" RadiusX="2" RadiusY="2" Fill="#8FA0FF" Opacity=".55" Margin="14,0" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#3ED598"/><Ellipse Width="7" Height="7" Fill="#3ED598" Margin="8,0"/><Ellipse Width="7" Height="7" Fill="#3ED598"/></StackPanel></Grid>
                            </Border>
                        </Border>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Text="颜色模式" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="system" Content="跟随系统"/><ComboBoxItem Tag="light" Content="浅色"/><ComboBoxItem Tag="dark" Content="深色"/></ComboBox></Grid>
                        <DockPanel Margin="0,14,0,0"><TextBlock Text="圆角"/><TextBlock x:Name="CornerValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="CornerSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="不透明度"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="宽度"/><TextBlock x:Name="WidthValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="WidthSlider" Minimum="190" Maximum="400" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="高度"/><TextBlock x:Name="HeightValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="HeightSlider" Minimum="32" Maximum="72" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                        <DockPanel><TextBlock Text="文本大小"/><TextBlock x:Name="TextSizeValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="TextSizeSlider" Minimum="9" Maximum="16" TickFrequency="0.5" ValueChanged="Setting_ValueChanged"/>
                        <UniformGrid Columns="2"><CheckBox x:Name="ShadowCheck" Tag="{StaticResource IconSpark}" Content="阴影" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="TopmostCheck" Tag="{StaticResource IconPin}" Content="始终置顶" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                    </StackPanel></Border>

                    <Border x:Name="ComponentCard" Style="{StaticResource Card}"><StackPanel><TextBlock Text="组件" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><UniformGrid Columns="2"><CheckBox x:Name="YoyoCheck" Tag="{StaticResource IconCircle}" Content="YOYO 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="CodexCheck" Tag="{StaticResource IconChart}" Content="Codex 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="WorkBuddyCheck" Tag="{StaticResource IconCoin}" Content="WorkBuddy 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="TrayIconCheck" Tag="{StaticResource IconScreen}" Content="系统托盘图标" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="StartupCheck" Tag="{StaticResource IconLaunch}" Content="开机自动启动" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid></StackPanel></Border>

                    <Border x:Name="FeatureCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="行为" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="显示模式" VerticalAlignment="Center"/><ComboBox x:Name="DisplayModeCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="always" Content="始终显示"/><ComboBoxItem Tag="activeOnly" Content="仅任务活动时显示"/></ComboBox></Grid>
                        <Border Margin="0,0,0,12" Padding="12" Background="#083ED598" BorderBrush="#303ED598" BorderThickness="1" CornerRadius="14">
                            <StackPanel>
                                <TextBlock Text="程序顺序" FontWeight="SemiBold"/>
                                <TextBlock Text="拖动整行即可排序；折叠额度、状态点、展开列表和多任务摘要会一起调整。" Foreground="#727C90" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                <ListBox x:Name="ProviderOrderList" ItemsSource="{Binding ProviderOrderItems, RelativeSource={RelativeSource AncestorType=Window}}"
                                         ItemContainerStyle="{StaticResource ProviderOrderItem}" Background="Transparent" BorderThickness="0"
                                         AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonDown="ProviderOrderList_PreviewMouseLeftButtonDown" PreviewMouseMove="ProviderOrderList_PreviewMouseMove"
                                         PreviewDragOver="ProviderOrderList_PreviewDragOver" PreviewDrop="ProviderOrderList_PreviewDrop" PreviewKeyDown="ProviderOrderList_PreviewKeyDown">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Border x:Name="OrderRow" Height="54" Padding="9,7" Background="{DynamicResource SettingsInputBackground}" CornerRadius="14">
                                                    <Border.Style><Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource SettingsInputBorder}"/><Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#8A3ED598"/></Trigger>
                                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style></Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Grid Width="16" Height="22" VerticalAlignment="Center" IsHitTestVisible="False" Opacity=".7">
                                                            <UniformGrid Rows="3" Columns="2"><Ellipse Width="3" Height="3" Fill="#727C90"/><Ellipse Width="3" Height="3" Fill="#727C90"/><Ellipse Width="3" Height="3" Fill="#727C90"/><Ellipse Width="3" Height="3" Fill="#727C90"/><Ellipse Width="3" Height="3" Fill="#727C90"/><Ellipse Width="3" Height="3" Fill="#727C90"/></UniformGrid>
                                                        </Grid>
                                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="11" Background="#43A878" IsHitTestVisible="False">
                                                            <Image Source="{Binding IconImage}" Width="26" Height="26" Stretch="Uniform"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding PositionText}" Foreground="#727C90" FontSize="11"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource ProviderOrderButton}" IsEnabled="{Binding CanMoveUp}" Tag="{Binding}" Click="ProviderMoveUp_Click" ToolTip="上移 (Alt+↑)" AutomationProperties.Name="上移"><Path Data="{StaticResource IconArrowUp}" Stroke="#657087" StrokeThickness="2.1" Width="15" Height="10" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                                            <Button Style="{StaticResource ProviderOrderButton}" IsEnabled="{Binding CanMoveDown}" Tag="{Binding}" Click="ProviderMoveDown_Click" ToolTip="下移 (Alt+↓)" AutomationProperties.Name="下移"><Path Data="{StaticResource IconArrowDown}" Stroke="#657087" StrokeThickness="2.1" Width="15" Height="10" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <Rectangle x:Name="DragOutline" Margin="0" RadiusX="14" RadiusY="14" Stroke="{DynamicResource SettingsAccent}" StrokeThickness="1.5" StrokeDashArray="4,3" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                <Border x:Name="InsertBefore" Height="3" CornerRadius="2" Background="{DynamicResource SettingsAccent}" VerticalAlignment="Top" Margin="10,-2,10,0" Visibility="Collapsed"/>
                                                <Border x:Name="InsertAfter" Height="3" CornerRadius="2" Background="{DynamicResource SettingsAccent}" VerticalAlignment="Bottom" Margin="10,0,10,-2" Visibility="Collapsed"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter TargetName="OrderRow" Property="Opacity" Value=".38"/><Setter TargetName="DragOutline" Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding InsertBefore}" Value="True"><Setter TargetName="InsertBefore" Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding InsertAfter}" Value="True"><Setter TargetName="InsertAfter" Property="Visibility" Value="Visible"/></DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <UniformGrid Columns="2"><CheckBox x:Name="CodexActivityCheck" Tag="{StaticResource IconClock}" Content="Codex 活动检测" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="CodexLimitsCheck" Tag="{StaticResource IconChart}" Content="Codex 限额" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="YoyoCreditsCheck" Tag="{StaticResource IconCircle}" Content="YOYO 积分" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="WorkBuddyCreditsCheck" Tag="{StaticResource IconCoin}" Content="WorkBuddy 积分" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="AppLaunchCheck" Tag="{StaticResource IconLaunch}" Content="点击打开应用" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="HoverExpansionCheck" Tag="{StaticResource IconEye}" Content="悬停展开" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="SpringAnimationCheck" Tag="{StaticResource IconSpark}" Content="回弹动效" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                        <StackPanel x:Name="HoverDelayPanel" Margin="0,10,0,0"><DockPanel><TextBlock Text="悬停延时"/><TextBlock x:Name="HoverDelayValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="HoverDelaySlider" Minimum="20" Maximum="400" TickFrequency="10" ValueChanged="Setting_ValueChanged"/></StackPanel>
                        <DockPanel><TextBlock Text="滚动速度"/><TextBlock x:Name="QuotaScrollSpeedValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="QuotaScrollSpeedSlider" Minimum="8" Maximum="80" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                    </StackPanel></Border>

                    <Border x:Name="NotificationCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="提醒与自动隐藏" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2"><CheckBox x:Name="CompletionNotificationsCheck" Tag="{StaticResource IconCheck}" Content="任务完成提醒" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="ConfirmationNotificationsCheck" Tag="{StaticResource IconClock}" Content="WorkBuddy 待确认" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="CodexResetReminderCheck" Tag="{StaticResource IconClock}" Content="Codex 额度重置提醒" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="YoyoAutoCheckinCheck" Tag="{StaticResource IconCheck}" Content="YOYO 开机联网签到" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="ReverseHoverCheck" Tag="{StaticResource IconEye}" Content="反向选择" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="FullscreenActiveOnlyCheck" Tag="{StaticResource IconScreen}" Content="全屏时活动显示" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="UnchangedAutoHideCheck" Tag="{StaticResource IconClock}" Content="状态未变化时隐藏" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                        <Grid Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><TextBlock Text="回复行数" VerticalAlignment="Center"/><ComboBox x:Name="MaxResponseLinesCombo" Grid.Column="1" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="1" Content="1 行"/><ComboBoxItem Tag="2" Content="2 行"/><ComboBoxItem Tag="3" Content="3 行"/><ComboBoxItem Tag="4" Content="4 行"/><ComboBoxItem Tag="5" Content="5 行"/><ComboBoxItem Tag="6" Content="6 行"/></ComboBox></Grid>
                        <StackPanel x:Name="CompletionDisplayPanel"><DockPanel><TextBlock Text="完成提醒时长"/><TextBlock x:Name="CompletionDisplayValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="CompletionDisplaySlider" Minimum="3" Maximum="30" TickFrequency="1" ValueChanged="Setting_ValueChanged"/></StackPanel>
                        <StackPanel x:Name="CodexResetReminderPanel"><DockPanel><TextBlock Text="额度重置前提醒"/><TextBlock x:Name="CodexResetReminderValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="CodexResetReminderSlider" Minimum="1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/></StackPanel>
                        <StackPanel x:Name="UnchangedAutoHidePanel"><DockPanel><TextBlock Text="未变化隐藏"/><TextBlock x:Name="UnchangedAutoHideValue" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="UnchangedAutoHideSlider" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Setting_ValueChanged"/></StackPanel>
                    </StackPanel></Border>

                    <Border x:Name="PositionCard" Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="位置" FontSize="18" FontWeight="SemiBold"/>
                        <Viewbox Height="270" Stretch="Uniform" Margin="0,14,0,12">
                            <Border x:Name="PositionPreviewSurface" Width="560" Height="315" CornerRadius="24" Background="#EEF1F7" BorderBrush="#263A4557" BorderThickness="2" Padding="16">
                                <Grid>
                                    <Border Height="18" CornerRadius="8" Background="#1A727C90" VerticalAlignment="Bottom"/>
                                    <RadioButton x:Name="TopLeftPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="左上" Tag="topLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Click="PositionPreset_Click"/>
                                    <RadioButton x:Name="TopCenterPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="顶部" Tag="topCenter" HorizontalAlignment="Center" VerticalAlignment="Top" Click="PositionPreset_Click"/>
                                    <RadioButton x:Name="TopRightPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="右上" Tag="topRight" HorizontalAlignment="Right" VerticalAlignment="Top" Click="PositionPreset_Click"/>
                                    <RadioButton x:Name="BottomLeftPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="左下" Tag="bottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,25" Click="PositionPreset_Click"/>
                                    <RadioButton x:Name="BottomCenterPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="底部" Tag="bottomCenter" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,25" Click="PositionPreset_Click"/>
                                    <RadioButton x:Name="BottomRightPreset" GroupName="PositionPreset" Style="{StaticResource PositionPresetButton}" Content="右下" Tag="bottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,25" Click="PositionPreset_Click"/>
                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SettingsInputBackground}" BorderBrush="{DynamicResource SettingsInputBorder}" BorderThickness="1" CornerRadius="13" Padding="18,10">
                                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPosition}" Stroke="#3ED598" StrokeThickness="2" Width="18" Height="18" Stretch="Uniform"/><TextBlock x:Name="PositionModeText" Text="拖动岛可自定义" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Viewbox>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="微调位置" FontWeight="SemiBold"/><TextBlock Text="每次移动 4 px" Foreground="#727C90" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                            <Grid Grid.Column="1" Width="150" Height="132" ClipToBounds="False" HorizontalAlignment="Right"><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource NudgeButton}" Tag="0,-4" Click="NudgePosition_Click" ToolTip="向上微调" AutomationProperties.Name="向上微调"><Path Data="M3,12 L12,3 L21,12" Stroke="#657087" StrokeThickness="2.2" Width="18" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource NudgeButton}" Tag="-4,0" Click="NudgePosition_Click" ToolTip="向左微调" AutomationProperties.Name="向左微调"><Path Data="M12,3 L3,12 L12,21" Stroke="#657087" StrokeThickness="2.2" Width="12" Height="18" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                <Border Grid.Row="1" Grid.Column="1" Width="34" Height="34" CornerRadius="17" Background="#183ED598"><Ellipse Width="8" Height="8" Fill="#3ED598"/></Border>
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource NudgeButton}" Tag="4,0" Click="NudgePosition_Click" ToolTip="向右微调" AutomationProperties.Name="向右微调"><Path Data="M3,3 L12,12 L3,21" Stroke="#657087" StrokeThickness="2.2" Width="12" Height="18" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource NudgeButton}" Tag="0,4" Click="NudgePosition_Click" ToolTip="向下微调" AutomationProperties.Name="向下微调"><Path Data="M3,3 L12,12 L21,3" Stroke="#657087" StrokeThickness="2.2" Width="18" Height="12" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                            </Grid>
                        </Grid>
                        <UniformGrid Columns="2"><CheckBox x:Name="ReplyFirstWhenExpandedUpCheck" Tag="{StaticResource IconPosition}" Content="向上展开时回复置顶" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/><CheckBox x:Name="AllowExpandedBeyondScreenCheck" Tag="{StaticResource IconScreen}" Content="允许展开越过屏幕边界" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/></UniformGrid>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
