<Window x:Class="YoyoClawCompanion.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 灵动岛主页" Width="540" Height="760" MinWidth="480" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" Foreground="#182033">
    <Window.Resources>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,6,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,8,8,0"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28">
            <TextBlock x:Name="TitleText" Text="AI 灵动岛" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText" Text="外观、组件与窗口行为" Foreground="#657087" FontSize="13" Margin="0,4,0,24"/>

            <Border x:Name="AppearanceCard" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="外观" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DockPanel Margin="0,0,0,8"><TextBlock Text="颜色模式" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" DockPanel.Dock="Right" Width="150" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="system" Content="跟随系统"/><ComboBoxItem Tag="light" Content="浅色"/><ComboBoxItem Tag="dark" Content="深色"/></ComboBox></DockPanel>
                    <DockPanel><TextBlock Text="圆角"/><TextBlock x:Name="CornerValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="CornerSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="不透明度"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="OpacitySlider" Minimum="55" Maximum="100" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="宽度"/><TextBlock x:Name="WidthValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="WidthSlider" Minimum="190" Maximum="340" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="文本大小"/><TextBlock x:Name="TextSizeValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="TextSizeSlider" Minimum="9" Maximum="16" TickFrequency="0.5" ValueChanged="Setting_ValueChanged"/>
                    <CheckBox x:Name="ShadowCheck" Content="显示阴影" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="TopmostCheck" Content="始终置顶" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border x:Name="ComponentCard" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="组件" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="QuotaCheck" Content="显示 YOYO 积分环" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="YoyoCheck" Content="显示 YOYO 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="CodexCheck" Content="显示 Codex 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="WorkBuddyCheck" Content="显示 WorkBuddy 状态点" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="TrayIconCheck" Content="在系统托盘显示 AI 灵动岛" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border x:Name="FeatureCard" Background="White" CornerRadius="14" Padding="20" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="功能与交互" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,8"><TextBlock Text="显示模式" VerticalAlignment="Center"/><ComboBox x:Name="DisplayModeCombo" DockPanel.Dock="Right" Width="180" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="always" Content="始终显示"/><ComboBoxItem Tag="activeOnly" Content="仅任务活动时显示"/></ComboBox></DockPanel>
                    <CheckBox x:Name="CodexActivityCheck" Content="检测 Codex 是否正在执行任务" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="CodexLimitsCheck" Content="显示 Codex 5 小时与周限额" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="WorkBuddyCreditsCheck" Content="显示 WorkBuddy 剩余积分" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="AppLaunchCheck" Content="允许点击组件打开对应应用" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="HoverExpansionCheck" Content="鼠标悬停时展开灵动岛" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="SpringAnimationCheck" Content="展开和收回使用回弹动效" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <CheckBox x:Name="CompletionNotificationsCheck" Content="任务完成时自动展开并显示回复" Checked="Setting_ValueChanged" Unchecked="Setting_ValueChanged"/>
                    <DockPanel Margin="0,2,0,8"><TextBlock Text="回复最大显示行数" VerticalAlignment="Center"/><ComboBox x:Name="MaxResponseLinesCombo" DockPanel.Dock="Right" Width="110" SelectionChanged="Setting_ValueChanged"><ComboBoxItem Tag="1" Content="1 行"/><ComboBoxItem Tag="2" Content="2 行"/><ComboBoxItem Tag="3" Content="3 行"/><ComboBoxItem Tag="4" Content="4 行"/><ComboBoxItem Tag="5" Content="5 行"/><ComboBoxItem Tag="6" Content="6 行"/></ComboBox></DockPanel>
                    <DockPanel><TextBlock Text="悬停展开延时"/><TextBlock x:Name="HoverDelayValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="HoverDelaySlider" Minimum="20" Maximum="400" TickFrequency="10" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="折叠态额度滚动速度"/><TextBlock x:Name="QuotaScrollSpeedValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="QuotaScrollSpeedSlider" Minimum="8" Maximum="80" TickFrequency="2" ValueChanged="Setting_ValueChanged"/>
                    <DockPanel><TextBlock Text="任务完成展开时间"/><TextBlock x:Name="CompletionDisplayValue" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                    <Slider x:Name="CompletionDisplaySlider" Minimum="3" Maximum="30" TickFrequency="1" ValueChanged="Setting_ValueChanged"/>
                </StackPanel>
            </Border>

            <Border x:Name="PositionCard" Background="White" CornerRadius="14" Padding="20">
                <StackPanel>
                    <TextBlock Text="位置" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="在灵动岛上按住约 0.4 秒，光标变化后即可拖动。位置会自动保存。" TextWrapping="Wrap" Foreground="#657087" Margin="0,8,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="恢复到顶部居中" Click="ResetPosition_Click"/>
                        <Button Content="恢复默认外观" Click="ResetAppearance_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
