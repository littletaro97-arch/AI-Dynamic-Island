<Window x:Class="YoyoClawCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Dynamic Island" Width="456" Height="96"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <Window.Resources>
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="16" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        <Style x:Key="IndicatorButton" TargetType="Button">
            <Setter Property="Width" Value="15"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <ContextMenu x:Key="IslandMenu">
            <MenuItem Header="打开主页" Click="OpenHome_Click"/><Separator/>
            <MenuItem Header="打开 YOYO Claw" Click="OpenYoyo_Click"/>
            <MenuItem Header="打开 Codex" Click="OpenCodex_Click"/>
            <MenuItem Header="打开 WorkBuddy" Click="OpenWorkBuddy_Click"/><Separator/>
            <MenuItem Header="刷新全部状态" Click="Refresh_Click"/>
            <MenuItem Header="退出 AI 灵动岛" Click="Exit_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Border x:Name="Island" Width="224" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                CornerRadius="24" Background="#EB0E121C" BorderBrush="#1AFFFFFF" BorderThickness="1"
                Effect="{StaticResource IslandShadow}" ContextMenu="{StaticResource IslandMenu}"
                MouseLeftButtonDown="Island_MouseLeftButtonDown" MouseLeftButtonUp="Island_MouseLeftButtonUp"
                MouseMove="Island_MouseMove" LostMouseCapture="Island_LostMouseCapture">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="YoyoButton" Click="OpenYoyo_Click" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Grid x:Name="QuotaDial" Width="32" Height="32">
                        <Ellipse Fill="#1A7188FF"/><Ellipse Stroke="#1AFFFFFF" StrokeThickness="2" Margin="1"/>
                        <Path x:Name="QuotaArc" Stroke="#8FA0FF" StrokeThickness="2" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat" Fill="Transparent"/>
                        <Path x:Name="BusyGlyph" Data="M 16,34 C 10,30 9,20 16,15 C 22,9 31,10 36,15 C 41,20 40,29 35,34 C 31,38 21,39 16,34 Z" Fill="#8FA0FF" Stretch="Uniform" Margin="8"/>
                    </Grid>
                </Button>
                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="HeadlineText" Text="正在读取状态…" Foreground="#F2F5FF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="SummaryText" Text="请稍候" Foreground="#9AA5BC" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="YoyoIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenYoyo_Click"><Ellipse x:Name="YoyoMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                    <Button x:Name="CodexIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenCodex_Click"><Ellipse x:Name="CodexMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                    <Button x:Name="WorkBuddyIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenWorkBuddy_Click"><Ellipse x:Name="WorkBuddyMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
