<Window x:Class="YoyoClawCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Dynamic Island" Width="456" Height="390"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <DropShadowEffect x:Key="IslandShadow" BlurRadius="16" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        <Geometry x:Key="MenuHomeIcon">M3,11 L12,3 L21,11 M6,9 L6,20 L18,20 L18,9 M10,20 L10,14 L14,14 L14,20</Geometry>
        <Geometry x:Key="MenuRefreshIcon">M20,8 A8,8 0 1 0 20,16 M20,4 L20,9 L15,9</Geometry>
        <Geometry x:Key="MenuCopyIcon">M8,8 L20,8 L20,20 L8,20 Z M4,16 L4,4 L16,4</Geometry>
        <Geometry x:Key="MenuExitIcon">M12,2 L12,12 M6,5 A9,9 0 1 0 18,5</Geometry>
        <SolidColorBrush x:Key="IslandMenuHoverBrush" Color="#16FFFFFF"/>
        <Style x:Key="IslandContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Padding" Value="6"/><Setter Property="MinWidth" Value="206"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
                <Border x:Name="MenuSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity=".38"/></Border.Effect>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IslandMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="9,0"/><Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="5,0,14,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{TemplateBinding Foreground}" Opacity=".65" FontSize="10.5" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource IslandMenuHoverBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".48"/></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True"/><Condition Property="Tag" Value="danger"/></MultiTrigger.Conditions><Setter TargetName="ItemSurface" Property="Background" Value="#24F2686F"/><Setter Property="Foreground" Value="#F2686F"/></MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IslandMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Margin" Value="8,4"/><Setter Property="Height" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IndicatorButton" TargetType="Button">
            <Setter Property="Width" Value="15"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RowLaunchButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SelectionBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#727C90"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#727C90"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SelectionBorder" Property="Background" Value="#14727C90"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssistantRowButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SelectionBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <Border x:Name="SelectionStripe" Width="3" HorizontalAlignment="Left" Margin="-1,7,0,7"
                                        CornerRadius="0,3,3,0" Background="#32C995" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#8FC9E7DA"/>
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#0C32C995"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#35C998"/>
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#1832C995"/>
                                <Setter TargetName="SelectionStripe" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="#35C998"/>
                                <Setter TargetName="SelectionBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="SelectionBorder" Property="Background" Value="#2432C995"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Island" Width="224" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                CornerRadius="24" Background="#EB0E121C" BorderBrush="#1AFFFFFF" BorderThickness="1"
                Effect="{StaticResource IslandShadow}"
                RenderTransformOrigin="0.5,0.5"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                PreviewMouseLeftButtonDown="Island_MouseLeftButtonDown" PreviewMouseLeftButtonUp="Island_MouseLeftButtonUp"
                PreviewMouseMove="Island_MouseMove"
                LostMouseCapture="Island_LostMouseCapture">
            <Border.RenderTransform><ScaleTransform x:Name="IslandVisibilityScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Grid Margin="10,0">
                <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid x:Name="CollapsedTextPanel" Margin="4,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False" UseLayoutRounding="True">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeadlineText" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="正在读取状态…" Foreground="#F2F5FF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Grid x:Name="SummaryViewport" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="15" ClipToBounds="True">
                        <Canvas x:Name="SummaryMarqueeCanvas" ClipToBounds="True">
                            <TextBlock x:Name="SummaryText" Text="请稍候" Foreground="#9AA5BC" FontSize="10.5" FontWeight="SemiBold" TextWrapping="NoWrap">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="SummaryPrimaryTranslate"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock x:Name="SummaryTextClone" Foreground="#9AA5BC" FontSize="10.5" FontWeight="SemiBold" TextWrapping="NoWrap" Visibility="Collapsed">
                                <TextBlock.RenderTransform><TranslateTransform x:Name="SummaryCloneTranslate"/></TextBlock.RenderTransform>
                            </TextBlock>
                        </Canvas>
                    </Grid>
                    </Grid>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="IndicatorPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="YoyoIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenYoyo_Click"><Ellipse x:Name="YoyoMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                        <Button x:Name="CodexIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenCodex_Click"><Ellipse x:Name="CodexMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                        <Button x:Name="WorkBuddyIndicatorButton" Style="{StaticResource IndicatorButton}" Click="OpenWorkBuddy_Click"><Ellipse x:Name="WorkBuddyMiniDot" Width="7" Height="7" Fill="#727C90"/></Button>
                    </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ExpandedPanel" Grid.Row="1" Opacity="0" Visibility="Collapsed" Margin="1,4,1,12" IsHitTestVisible="True">
                    <Grid.RowDefinitions><RowDefinition x:Name="ExpandedRow0" Height="24"/><RowDefinition x:Name="ExpandedRow1" Height="24"/><RowDefinition x:Name="ExpandedRow2" Height="24"/><RowDefinition x:Name="ExpandedRow3" Height="*"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="102"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#727C90" VerticalAlignment="Center"/>
                    <TextBlock x:Name="YoyoLabel" Grid.Column="1" Text="YOYO Claw" Foreground="#F2F5FF" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StateText" Grid.Column="2" Text="读取中" Foreground="#9AA5BC" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PointsText" Grid.Column="3" Text="--" Foreground="#8FA0FF" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="CodexDot" Grid.Row="1" Width="8" Height="8" Fill="#727C90" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodexLabel" Grid.Row="1" Grid.Column="1" Text="Codex" Foreground="#F2F5FF" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CodexStateText" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Text="未运行" Foreground="#9AA5BC" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Ellipse x:Name="WorkBuddyDot" Grid.Row="2" Width="8" Height="8" Fill="#727C90" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WorkBuddyLabel" Grid.Row="2" Grid.Column="1" Text="WorkBuddy" Foreground="#F2F5FF" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="WorkBuddyStateText" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Text="未运行" Foreground="#9AA5BC" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <Border x:Name="RecentBorder" Grid.Row="3" Grid.ColumnSpan="4" Background="#B8182033" CornerRadius="12" Padding="10,5" Margin="0,6,0,0">
                        <TextBlock x:Name="RecentResultText" Text="尚未检测到任务结果" Foreground="#B9C2D4" FontSize="10.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="15" VerticalAlignment="Top"/>
                    </Border>
                    <RadioButton x:Name="YoyoRowButton" Grid.Row="0" Grid.ColumnSpan="4" GroupName="AssistantSelection" Style="{StaticResource AssistantRowButton}" Click="OpenYoyo_Click"/>
                    <RadioButton x:Name="CodexRowButton" Grid.Row="1" Grid.ColumnSpan="4" GroupName="AssistantSelection" Style="{StaticResource AssistantRowButton}" Click="OpenCodex_Click"/>
                    <RadioButton x:Name="WorkBuddyRowButton" Grid.Row="2" Grid.ColumnSpan="4" GroupName="AssistantSelection" Style="{StaticResource AssistantRowButton}" Click="OpenWorkBuddy_Click"/>
                </Grid>
                <Button x:Name="CollapseHandleButton" Grid.Row="0" Width="120" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top"
                        VerticalContentAlignment="Top"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="CollapseHandle_Click" ToolTip="收起灵动岛"
                        AutomationProperties.Name="收起灵动岛">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent"><Border x:Name="Handle" Width="46" Height="4" CornerRadius="2" Background="#66727C90" HorizontalAlignment="Center" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="0,3"/></Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#AA727C90"/></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Handle" Property="Background" Value="#CC3ED598"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
