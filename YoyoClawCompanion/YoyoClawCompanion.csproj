<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>AI Dynamic Island</AssemblyTitle>
    <Product>AI Dynamic Island</Product>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <InformationalVersion>0.6.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\THIRD_PARTY_NOTICES\YOYOClawCheckin-LICENSE.txt">
      <Link>THIRD_PARTY_NOTICES\YOYOClawCheckin-LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\magicore-bridge\**\*"
             Exclude="..\magicore-bridge\node_modules\.cache\**\*;..\magicore-bridge\node_modules\.bin\**\*;..\magicore-bridge\node_modules\@types\**\*;..\magicore-bridge\node_modules\undici-types\**\*;..\magicore-bridge\node_modules\**\*.d.ts;..\magicore-bridge\node_modules\**\*.map;..\magicore-bridge\probe.mjs;..\magicore-bridge\package-lock.json">
      <Link>magicore-bridge\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
